# Generated by editor-pro's release workflow. Do not edit checksums by hand.
class EditorPro < Formula
  desc "Terminal-native, Vim-inspired code editor"
  homepage "https://github.com/$repository"
  version "$version"

  depends_on macos: :sonoma

  on_arm do
    url "$base_url/editor-pro-v$version-aarch64-apple-darwin.tar.gz"
    sha256 "$arm_sha256"
  end

  on_intel do
    url "$base_url/editor-pro-v$version-x86_64-apple-darwin.tar.gz"
    sha256 "$intel_sha256"
  end

  def install
    bin.install "editor-pro"
    bin.install_symlink bin/"editor-pro" => "ep"
  end

  test do
    assert_equal "editor-pro #{version}", shell_output("#{bin}/editor-pro --version").strip
    assert_equal "editor-pro #{version}", shell_output("#{bin}/ep --version").strip
  end
end
